# ---- AI ----
AI_PROVIDERS=groq,gemini,openrouter
APP_URL=
GROQ_API_KEY=
GROQ_MODELS_FAST=openai/gpt-oss-20b,llama-3.1-8b-instant
GROQ_MODELS_HEAVY=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
GEMINI_API_KEY=          # optional backup (free tier from Google AI Studio)
OPENROUTER_API_KEY=
OPENROUTER_MODELS_FAST=
OPENROUTER_MODELS_HEAVY=
OPENROUTER_RPM=18
OPENROUTER_WEB=0
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Database (accounts + saved searches) ----
# Add "Upstash for Redis" from the Vercel Marketplace and these are set for you.
# Without them the app uses temporary in-memory storage (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# ---- Auth ----
AUTH_SECRET=change-me-to-a-long-random-string
# Demo account: recruiter@demo.com
DEMO_EMAIL=recruiter@demo.com
DEMO_PASSWORD=Demo@123
